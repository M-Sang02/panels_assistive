<?xml version="1.0" encoding="utf-8"?>
<!-- Image / QR card: one painted bitmap fills the slot at any launcher size, so
     2x2, 2x3, 3x2 and larger resizes all share the same glass silhouette. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_image_bg"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/image_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:text="Chạm để thêm ảnh hoặc mã QR"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp" />
</FrameLayout>
