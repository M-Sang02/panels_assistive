<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/widget_minus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_button_bg"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wg_minus"
            android:contentDescription="Giảm âm lượng" />

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_bg"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wg_prev"
            android:contentDescription="Bài trước" />

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/widget_play_bg"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_wg_play"
                android:contentDescription="Phát hoặc tạm dừng" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_bg"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wg_next"
            android:contentDescription="Bài tiếp theo" />

        <ImageButton
            android:id="@+id/widget_plus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_button_bg"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wg_plus"
            android:contentDescription="Tăng âm lượng" />
    </LinearLayout>
</FrameLayout>
