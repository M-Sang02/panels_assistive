<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/widget_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_bg"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wg_minus"
            android:contentDescription="Giảm âm lượng" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textColor="#F4F6FA"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ÂM LƯỢNG"
                android:textColor="#B9C2CE"
                android:textSize="9sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_bg"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_wg_plus"
            android:contentDescription="Tăng âm lượng" />
    </LinearLayout>
</FrameLayout>
