<?xml version="1.0" encoding="utf-8"?>
<!-- Large music card (4x4): big art, roomy text and evenly spread oversized controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/widget_art_bg"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh bìa" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Chưa phát nhạc"
                    android:textColor="#E6182434"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Chạm để mở ứng dụng nhạc"
                    android:textColor="#B0182434"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Bài trước"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_play_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/widget_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Phát hoặc tạm dừng"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wg_play" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Bài tiếp theo"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
