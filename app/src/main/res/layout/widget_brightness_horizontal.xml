<?xml version="1.0" encoding="utf-8"?>
<!-- Thin brightness bar (2x1): left half dims, right half brightens, one sun glyph. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Giảm độ sáng" />

        <LinearLayout
            android:id="@+id/widget_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Tăng độ sáng" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_down_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/widget_up_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />
</FrameLayout>
